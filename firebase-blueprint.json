{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "البيانات الخاصة بحساب المستخدم المالك فقط في Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "معرف المستخدم الفريد UID" },
        "email": { "type": "string", "description": "البريد الإلكتروني المرتبط بالحساب" },
        "displayName": { "type": "string", "maxLength": 80, "description": "اسم العرض للقارئ" },
        "username": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^([a-z0-9_]{4,24}|zid)$", "description": "اسم المستخدم اللاتيني الفريد (4-24 حرفاً، مع استثناء @zid للإدارة فقط)" },
        "bio": { "type": "string", "maxLength": 320, "description": "النبذة الشخصية" },
        "photoURL": { "type": "string", "maxLength": 450000, "description": "رابط الصورة الشخصية" },
        "coverURL": { "type": "string", "maxLength": 450000, "description": "رابط صورة الغلاف 1500x800" },
        "isPublic": { "type": "boolean", "description": "حالة خصوصية الحساب (عام أو خاص)" },
        "showSavedNovels": { "type": "boolean", "description": "إظهار الروايات المحفوظة للزوار" },
        "showReadingHistory": { "type": "boolean", "description": "إظهار سجل الفصول المقروءة للزوار" },
        "showProfileInfo": { "type": "boolean", "description": "إظهار النبذة ومعلومات الملف الشخصي للزوار" },
        "createdAt": { "type": "string", "description": "تاريخ إنشاء الحساب" },
        "updatedAt": { "type": "string", "description": "تاريخ آخر تحديث" }
      },
      "required": ["id", "email"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "الملف التعريفي الخاضع لقواعد الخصوصية بدون أي بيانات حساسة (PII)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 24 },
        "photoURL": { "type": "string", "maxLength": 450000 },
        "coverURL": { "type": "string", "maxLength": 450000 },
        "isPublic": { "type": "boolean" },
        "showSavedNovels": { "type": "boolean" },
        "showReadingHistory": { "type": "boolean" },
        "showProfileInfo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "isPublic"]
    },
    "PublicProfileBio": {
      "title": "PublicProfileBio",
      "description": "النبذة الشخصية المحمية بإعداد إظهار معلومات الملف الشخصي",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "bio": { "type": "string", "maxLength": 320 },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "bio"]
    },
    "PublicProfileStat": {
      "title": "PublicProfileStat",
      "description": "ملخص إحصائية فردية (عدد الروايات المحفوظة أو عدد الفصول المقروءة)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "count": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "count"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "سجل حجز اسم المستخدم الفريد الذري غير الحساس لحالة الأحرف",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^([a-z0-9_]{4,24}|zid)$" },
        "isPublic": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username", "isPublic"]
    },
    "UsernameRedirect": {
      "title": "UsernameRedirect",
      "description": "تحويل أسماء المستخدمين القديمة لمنع الروابط المكسورة",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "currentUsername": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^([a-z0-9_]{4,24}|zid)$" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "currentUsername"]
    },
    "FounderSeal": {
      "title": "FounderSeal",
      "description": "سجل توثيق شارة المؤسس والمشرف الرسمي بدون أي بيانات شخصية",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "badge": { "type": "string", "enum": ["founder"] },
        "handle": { "type": "string", "enum": ["zid"] },
        "titleAr": { "type": "string" },
        "titleEn": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "badge", "handle", "active"]
    },
    "PublishedNovel": {
      "title": "PublishedNovel",
      "description": "رواية منشورة من قبل كاتب معتمد الصلاحية وتبقى متاحة للعامة",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "titleEn": { "type": "string", "maxLength": 160 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "workType": { "type": "string", "enum": ["original", "translated", "republish"] },
        "originalAuthor": { "type": "string", "maxLength": 80 },
        "firstAuthor": { "type": "string", "maxLength": 80 },
        "supportMethod": { "type": "string", "maxLength": 240 },
        "novelStatus": { "type": "string", "enum": ["ongoing", "completed", "paused"] },
        "moderationStatus": { "type": "string", "enum": ["active", "under_review", "rejected_removed"] },
        "moderationNote": { "type": "string", "maxLength": 500 },
        "reportCount": { "type": "number" },
        "genre": { "type": "string", "maxLength": 80 },
        "categoryGroup": { "type": "string", "enum": ["novels", "epics", "wisdom", "heritage"] },
        "coverUrl": { "type": "string", "maxLength": 450000 },
        "description": { "type": "string", "maxLength": 2000 },
        "readingHours": { "type": "number" },
        "originLanguage": { "type": "string", "maxLength": 60 },
        "languageCode": { "type": "string", "maxLength": 12 },
        "verifiedReadsCount": { "type": "number" },
        "lastVerifiedReadKey": { "type": "string" },
        "publishedChapterCount": { "type": "number" },
        "publishedWordsAr": { "type": "number" },
        "publishedWordsEn": { "type": "number" },
        "tags": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "authorId", "isPublished"]
    },
    "NovelSection": {
      "title": "NovelSection",
      "description": "مجلد أو قسم تنظيمي لفصول الرواية",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "novelId": { "type": "string" },
        "authorId": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "titleEn": { "type": "string", "maxLength": 120 },
        "orderIndex": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "novelId", "authorId", "title", "orderIndex"]
    },
    "LogicalChapter": {
      "title": "LogicalChapter",
      "description": "فصل منطقي يحتوي على النسختين العربية والإنجليزية المستقلتين ونوع الفصل وحالته",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "novelId": { "type": "string" },
        "authorId": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "titleEn": { "type": "string", "maxLength": 160 },
        "sectionId": { "type": "string" },
        "chapterType": { "type": "string", "enum": ["narrative", "explanatory"] },
        "endStatus": { "type": "string", "enum": ["ongoing", "ending"] },
        "languageMode": { "type": "string", "enum": ["ar", "en", "both"] },
        "editions": { "type": "object" },
        "wordCountAr": { "type": "number" },
        "wordCountEn": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "revision": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "novelId", "authorId", "chapterNumber", "title", "chapterType", "endStatus", "languageMode", "revision"]
    },
    "ChapterSlot": {
      "title": "ChapterSlot",
      "description": "قفل ذري يمنع تكرار رقم الفصل داخل الرواية الواحدة",
      "type": "object",
      "properties": {
        "chapterId": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["chapterId", "chapterNumber", "authorId"]
    },
    "ReadSession": {
      "title": "ReadSession",
      "description": "جلسة قراءة موثقة بزمن الخادم للتحقق من إتمام دقيقة كاملة",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "readerKey": { "type": "string" },
        "userId": { "type": "string" },
        "startedAt": { "type": "string" },
        "consumed": { "type": "boolean" }
      },
      "required": ["sessionId", "novelId", "chapterId", "readerKey", "startedAt", "consumed"]
    },
    "VerifiedRead": {
      "title": "VerifiedRead",
      "description": "سجل قراءة موثقة واحدة لكل قارئ بعد انقضاء ٦٠ ثانية بتوقيت الخادم",
      "type": "object",
      "properties": {
        "novelId": { "type": "string" },
        "readerKey": { "type": "string" },
        "userId": { "type": "string" },
        "chapterId": { "type": "string" },
        "sessionId": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["novelId", "readerKey", "chapterId", "sessionId", "verifiedAt"]
    },
    "WorkReport": {
      "title": "WorkReport",
      "description": "بلاغ قارئ عن عمل أو غلاف مخالف لمراجعة المشرف الرسمي",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "authorId": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reason": { "type": "string", "minLength": 2, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "reviewed_kept", "rejected_removed"] },
        "reviewedBy": { "type": "string" },
        "reviewNote": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "novelId", "reporterUid", "reason", "status"]
    },
    "WriterApplication": {
      "title": "WriterApplication",
      "description": "طلب الحصول على صلاحية كاتب وشارة الكاتب للمراجعة الإدارية",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "penName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "shortBio": { "type": "string", "minLength": 5, "maxLength": 500 },
        "genres": { "type": "array" },
        "writingSample": { "type": "string", "minLength": 20, "maxLength": 10000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "penName", "shortBio", "genres", "writingSample", "status"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "الروايات المحفوظة في مفضلة المستخدم",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "coverUrl": { "type": "string" },
        "author": { "type": "string" },
        "genre": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "novelId"]
    },
    "ReadingHistoryEntry": {
      "title": "ReadingHistoryEntry",
      "description": "سجل الفصول التي قرأها المستخدم",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "chapterId": { "type": "number" },
        "chapterTitle": { "type": "string" },
        "readAt": { "type": "string" }
      },
      "required": ["userId", "novelId", "chapterId"]
    },
    "UserRating": {
      "title": "UserRating",
      "description": "تقييم المستخدم للرواية",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "novelId": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "novelId", "rating"]
    },
    "ChapterComment": {
      "title": "ChapterComment",
      "description": "تعليق القارئ على فصل محدد",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userCover": { "type": "string" },
        "userRole": { "type": "string" },
        "text": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "novelId", "chapterId", "userId", "text"]
    },
    "CommentReaction": {
      "title": "CommentReaction",
      "description": "سجل تفاعل المستخدم الفردي مع التعليق",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "commentId": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "commentId", "type"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "الرتبة المعتمدة للمستخدم الممنوحة من الإدارة فقط",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "roles": { "type": "array" },
        "status": { "type": "string" },
        "canPublish": { "type": "boolean" },
        "assignedBy": { "type": "string" },
        "assignedAt": { "type": "string" }
      },
      "required": ["userId", "role", "status"]
    },
    "RoleRequest": {
      "title": "RoleRequest",
      "description": "طلب انضمام لرتبة مدقق أو كاتب أو مترجم",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "enum": ["auditor", "author", "translate"] },
        "statement": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "role", "statement", "status"]
    },
    "AuditReview": {
      "title": "AuditReview",
      "description": "مراجعة وتدقيق عمل أدبي أو فصل بواسطة مدقق معتمد",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "chapterId": { "type": "string" },
        "chapterTitle": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerName": { "type": "string" },
        "decision": { "type": "string" },
        "explanation": { "type": "string" },
        "evidence": { "type": "string" },
        "concernType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "novelId", "reviewerId", "decision"]
    },
    "WorkModeration": {
      "title": "WorkModeration",
      "description": "حالة رقابة ونشر العمل الأدبي ومحصلة قرارات التدقيق",
      "type": "object",
      "properties": {
        "novelId": { "type": "string" },
        "status": { "type": "string" },
        "approvalCount": { "type": "number" },
        "issueCount": { "type": "number" },
        "requiredApprovals": { "type": "number" },
        "hasCopyrightConcern": { "type": "boolean" },
        "suspendedReason": { "type": "string" },
        "lastAuditedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["novelId", "status"]
    },
    "ModerationLog": {
      "title": "ModerationLog",
      "description": "سجل القرارات الإدارية والتحقيقية الصادرة عن الإدارة",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "action": { "type": "string" },
        "reason": { "type": "string" },
        "decidedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetType", "targetId", "action", "reason", "decidedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "بيانات المالك الخاصة (البريد والإعدادات الخاصة) مقصورة على صاحب الحساب فقط"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "المفضلة الخاصة بالمستخدم"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "ReadingHistoryEntry",
      "description": "سجل الفصول المقروءة الخاص بالمستخدم"
    },
    "/users/{userId}/ratings/{ratingId}": {
      "schema": "UserRating",
      "description": "تقييمات المستخدم للروايات"
    },
    "/public_profiles/{userId}": {
      "schema": "PublicProfile",
      "description": "الملف الشخصي العام المحكوم بإعدادات الخصوصية على مستوى القواعد"
    },
    "/public_profiles/{userId}/details/{detailId}": {
      "schema": "PublicProfileBio",
      "description": "النبذة الشخصية المحكومة بخيار إظهار معلومات الملف الشخصي"
    },
    "/public_profiles/{userId}/stats/{statId}": {
      "schema": "PublicProfileStat",
      "description": "إحصائيات المحفوظات والفصول المقروءة المحكومة بإعدادات الخصوصية"
    },
    "/public_profiles/{userId}/saved_novels/{novelId}": {
      "schema": "Bookmark",
      "description": "قائمة الروايات المحفوظة المكشوفة فقط عند تفعيل إظهار المحفوظات والحساب العام"
    },
    "/usernames/{usernameLower}": {
      "schema": "UsernameReservation",
      "description": "حجز ذري فريد لاسم المستخدم غير الحساس لحالة الأحرف"
    },
    "/username_redirects/{oldUsername}": {
      "schema": "UsernameRedirect",
      "description": "إعادة توجيه الروابط القديمة بعد تغيير اسم المستخدم"
    },
    "/founders/{founderId}": {
      "schema": "FounderSeal",
      "description": "سجل التوثيق العام لشارة المؤسس والمشرف الرسمي"
    },
    "/novels/{novelId}": {
      "schema": "PublishedNovel",
      "description": "الروايات المنشورة بواسطة الكتاب المعتمدين وتبقى عامة للزوار"
    },
    "/novels/{novelId}/sections/{sectionId}": {
      "schema": "NovelSection",
      "description": "الأقسام والمجلدات التنظيمية لفصول الرواية"
    },
    "/novels/{novelId}/chapters/{chapterId}": {
      "schema": "LogicalChapter",
      "description": "الفصول المنطقية متعددة اللغات ونوع الفصل وحالة النشر"
    },
    "/novels/{novelId}/chapter_slots/{slotId}": {
      "schema": "ChapterSlot",
      "description": "قفل فريد لأرقام الفصول داخل الرواية"
    },
    "/novels/{novelId}/read_sessions/{sessionId}": {
      "schema": "ReadSession",
      "description": "جلسات القراءة الزمنية للتحقق من قضاء دقيقة كاملة"
    },
    "/novels/{novelId}/verified_reads/{readerKey}": {
      "schema": "VerifiedRead",
      "description": "سجل القراءة الموثقة الفريد لكل قارئ"
    },
    "/work_reports/{reportId}": {
      "schema": "WorkReport",
      "description": "بلاغات القرّاء حول المخالفات لمراجعة المشرف الرسمي"
    },
    "/writer_applications/{userId}": {
      "schema": "WriterApplication",
      "description": "طلبات الحصول على صلاحية كاتب للمراجعة الإدارية"
