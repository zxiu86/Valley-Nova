rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ================= HELPER FUNCTIONS ================= //
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 4 && name.size() <= 24 && name.matches('^[a-z0-9_]+$');
    }

    function isReservedUsername(name) {
      return name in [
        'admin', 'administrator', 'support', 'help', 'root', 'system',
        'moderator', 'mod', 'staff', 'founder', 'api', 'auth', 'login',
        'register', 'profile', 'settings', 'explore', 'reading', 'details',
        'mtx', 'official', 'null', 'undefined', 'account', 'writer', 'author'
      ];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Cryptographically verified founder / bootstrapped admin via Firebase Auth token
    function isDesignatedFounder() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'zly30257@gmail.com';
    }

    function isFounder() {
      return isSignedIn() && (
        isDesignatedFounder() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/founders/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'founder' &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isAdmin() {
      return isFounder();
    }

    function hasRole(roleName) {
      return isSignedIn() && (
        isFounder() ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.status == 'active' &&
         (get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == roleName ||
          (get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles is list &&
           roleName in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles)))
      );
    }

    function isAuditor() {
      return hasRole('auditor');
    }

    function isApprovedWriter() {
      return isSignedIn() && (
        isFounder() ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.status == 'active' &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.canPublish == true &&
         (get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'author' ||
          (get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles is list &&
           'author' in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roles)))
      );
    }

    function isNovelAuthor(novelId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/novels/$(novelId)) &&
        get(/databases/$(database)/documents/novels/$(novelId)).data.authorId == request.auth.uid;
    }

    function isNovelPubliclyVisible(novelId) {
      return exists(/databases/$(database)/documents/novels/$(novelId)) &&
        get(/databases/$(database)/documents/novels/$(novelId)).data.isPublished == true &&
        get(/databases/$(database)/documents/novels/$(novelId)).data.get('moderationStatus', 'active') != 'rejected_removed';
    }

    function isAllowedUsernamePath(name) {
      return isValidUsername(name) || name == 'zid';
    }

    function isAllowedUsernameWrite(name) {
      return (isValidUsername(name) && !isReservedUsername(name)) || (name == 'zid' && isAdmin());
    }

    function isValidSafeImageUrl(url) {
      return url is string &&
        url.size() <= 450000 &&
        (url == '' ||
         url.matches('^https://.*') ||
         url.matches('^/images/.*') ||
         url.matches('^data:image/(webp|png|jpeg);base64,.*'));
    }

    function isValidPublicProfile(data) {
      return data.uid is string &&
        data.uid.size() <= 128 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.isPublic is bool &&
        data.showSavedNovels is bool &&
        data.showReadingHistory is bool &&
        data.showProfileInfo is bool &&
        (!('username' in data) || data.username == '' || isAllowedUsernameWrite(data.username)) &&
        (!('photoURL' in data) || isValidSafeImageUrl(data.photoURL)) &&
        (!('coverURL' in data) || isValidSafeImageUrl(data.coverURL)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        !('email' in data) &&
        !('role' in data) &&
        !('roles' in data) &&
        !('isWriter' in data) &&
        !('isAuthor' in data) &&
        !('canPublish' in data) &&
        !('isFounder' in data) &&
        !('isAdmin' in data);
    }

    function isValidPrivateUserDoc(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.email is string &&
        data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
        (!('username' in data) || data.username == '' || isAllowedUsernameWrite(data.username)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 320)) &&
        (!('photoURL' in data) || isValidSafeImageUrl(data.photoURL)) &&
        (!('coverURL' in data) || isValidSafeImageUrl(data.coverURL)) &&
        (!('isPublic' in data) || data.isPublic is bool) &&
        (!('showSavedNovels' in data) || data.showSavedNovels is bool) &&
        (!('showReadingHistory' in data) || data.showReadingHistory is bool) &&
        (!('showProfileInfo' in data) || data.showProfileInfo is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        !('role' in data) &&
        !('roles' in data) &&
        !('isWriter' in data) &&
        !('isAuthor' in data) &&
        !('canPublish' in data) &&
        !('isFounder' in data) &&
        !('isAdmin' in data);
    }

    function isValidWriterApplication(data) {
      return data.userId is string &&
        data.userId.size() <= 128 &&
        data.penName is string &&
        data.penName.size() >= 2 &&
        data.penName.size() <= 80 &&
        data.shortBio is string &&
        data.shortBio.size() >= 10 &&
        data.shortBio.size() <= 400 &&
        data.genres is list &&
        data.genres.size() >= 1 &&
        data.genres.size() <= 8 &&
        data.genres[0] is string &&
        data.writingSample is string &&
        data.writingSample.size() >= 50 &&
        data.writingSample.size() <= 8000 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64)) &&
        (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidNovelPayload(data) {
      return data.keys().hasAll(['id', 'title', 'authorId', 'categoryGroup', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'titleEn', 'authorId', 'authorName', 'workType',
          'originalAuthor', 'firstAuthor', 'supportMethod', 'novelStatus',
          'moderationStatus', 'moderationNote', 'reportCount', 'genre',
          'categoryGroup', 'coverUrl', 'description', 'readingHours',
          'originLanguage', 'languageCode', 'verifiedReadsCount', 'lastVerifiedReadKey',
          'publishedChapterCount', 'publishedWordsAr', 'publishedWordsEn', 'tags',
          'isPublished', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 160)) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 80)) &&
        (!('workType' in data) || data.workType in ['original', 'translated', 'republish']) &&
        (!('originalAuthor' in data) || (data.originalAuthor is string && data.originalAuthor.size() <= 80)) &&
        (!('firstAuthor' in data) || (data.firstAuthor is string && data.firstAuthor.size() <= 80)) &&
        (data.get('workType', 'original') != 'translated' || (data.get('originalAuthor', '') is string && data.get('originalAuthor', '').size() >= 2)) &&
        (data.get('workType', 'original') != 'republish' || (data.get('firstAuthor', '') is string && data.get('firstAuthor', '').size() >= 2)) &&
        (!('supportMethod' in data) || (data.supportMethod is string && data.supportMethod.size() <= 240)) &&
        (!('novelStatus' in data) || data.novelStatus in ['ongoing', 'completed', 'paused']) &&
        (!('moderationStatus' in data) || data.moderationStatus in ['active', 'under_review', 'rejected_removed']) &&
        (!('moderationNote' in data) || (data.moderationNote is string && data.moderationNote.size() <= 500)) &&
        (!('reportCount' in data) || (data.reportCount is int && data.reportCount >= 0)) &&
        (!('genre' in data) || (data.genre is string && data.genre.size() <= 80)) &&
        data.categoryGroup in ['novels', 'epics', 'wisdom', 'heritage'] &&
        (!('coverUrl' in data) || isValidSafeImageUrl(data.coverUrl)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('readingHours' in data) || (data.readingHours is number && data.readingHours >= 0 && data.readingHours <= 2000)) &&
        (!('originLanguage' in data) || (data.originLanguage is string && data.originLanguage.size() <= 60)) &&
        (!('languageCode' in data) || (data.languageCode is string && data.languageCode.size() <= 12)) &&
        (!('verifiedReadsCount' in data) || (data.verifiedReadsCount is int && data.verifiedReadsCount >= 0)) &&
        (!('lastVerifiedReadKey' in data) || (data.lastVerifiedReadKey is string && data.lastVerifiedReadKey.size() <= 128)) &&
        (!('publishedChapterCount' in data) || (data.publishedChapterCount is int && data.publishedChapterCount >= 0)) &&
        (!('publishedWordsAr' in data) || (data.publishedWordsAr is int && data.publishedWordsAr >= 0)) &&
        (!('publishedWordsEn' in data) || (data.publishedWordsEn is int && data.publishedWordsEn >= 0)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 12)) &&
        data.isPublished is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSectionPayload(data, novelId) {
      return data.keys().hasAll(['id', 'novelId', 'authorId', 'title', 'orderIndex', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'novelId', 'authorId', 'title', 'titleEn', 'orderIndex', 'createdAt', 'updatedAt']) &&
        data.novelId == novelId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 120)) &&
        data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 5000 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidChapterPayload(data, novelId) {
      return data.keys().hasAll([
          'id', 'novelId', 'authorId', 'chapterNumber', 'title',
          'chapterType', 'endStatus', 'languageMode', 'editions',
          'wordCountAr', 'wordCountEn', 'isPublished', 'revision',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'novelId', 'authorId', 'chapterNumber', 'title', 'titleEn',
          'sectionId', 'chapterType', 'endStatus', 'languageMode', 'editions',
          'wordCountAr', 'wordCountEn', 'isPublished', 'revision',
          'createdAt', 'updatedAt'
        ]) &&
        data.novelId == novelId &&
        data.chapterNumber is int && data.chapterNumber >= 1 && data.chapterNumber <= 50000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 160)) &&
        (!('sectionId' in data) || (data.sectionId is string && data.sectionId.size() <= 128)) &&
        data.chapterType in ['narrative', 'explanatory'] &&
        data.endStatus in ['ongoing', 'ending'] &&
        data.languageMode in ['ar', 'en', 'both'] &&
        data.editions is map &&
        data.wordCountAr is int && data.wordCountAr >= 0 &&
        data.wordCountEn is int && data.wordCountEn >= 0 &&
        data.isPublished is bool &&
        data.revision is int && data.revision >= 1 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // ================= ADMIN & FOUNDER COLLECTIONS ================= //
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list: if false;
      allow create, update: if isValidId(adminId) && isDesignatedFounder() && adminId == request.auth.uid;
      allow delete: if false;
    }

    match /founders/{founderId} {
      // Public get contains only non-PII seal verification flags (no email/phone/PII)
      allow get: if isValidId(founderId);
      allow list: if isAdmin();
      allow create, update: if isValidId(founderId) &&
        isDesignatedFounder() &&
        founderId == request.auth.uid &&
        incoming().keys().hasAll(['uid', 'badge', 'handle', 'active']) &&
        incoming().keys().hasOnly(['uid', 'badge', 'handle', 'titleAr', 'titleEn', 'active', 'updatedAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().badge == 'founder' &&
        incoming().handle == 'zid' &&
        incoming().active is bool;
      allow delete: if false;
    }

    // Trusted User Roles Collection (strictly admin-managed; users cannot grant themselves roles or badges)
    match /user_roles/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isAdmin() &&
        incoming().userId == userId &&
        incoming().role in ['reader', 'author', 'auditor', 'translate', 'founder'] &&
        incoming().status in ['active', 'revoked'];
      allow delete: if isValidId(userId) && isAdmin();
    }

    // ================= WRITER APPLICATIONS COLLECTION ================= //
    match /writer_applications/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        !exists(/databases/$(database)/documents/writer_applications/$(userId)) &&
        isValidWriterApplication(incoming()) &&
        incoming().keys().hasAll(['userId', 'penName', 'shortBio', 'genres', 'writingSample', 'status', 'submittedAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'penName', 'shortBio', 'genres', 'writingSample', 'status', 'submittedAt', 'updatedAt']) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';
      allow update: if isValidId(userId) && isValidWriterApplication(incoming()) && (
        (isAdmin() && incoming().userId == existing().userId) ||
        (isOwner(userId) &&
         existing().status == 'rejected' &&
         incoming().userId == existing().userId &&
         incoming().status == 'pending' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['penName', 'shortBio', 'genres', 'writingSample', 'status', 'submittedAt', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Legacy Role Join Requests Collection
    match /role_requests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().role in ['auditor', 'author', 'translate'] &&
        incoming().userEmail is string && incoming().userEmail.size() <= 200;
      allow update: if isAdmin();
      allow delete: if isValidId(requestId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ================= PRIVATE OWNER ACCOUNT DOCS (PII ISOLATED) ================= //
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        incoming().id == userId &&
        incoming().keys().hasOnly([
          'id', 'email', 'displayName', 'username', 'bio', 'photoURL', 'coverURL',
          'isPublic', 'showSavedNovels', 'showReadingHistory', 'showProfileInfo',
          'createdAt', 'updatedAt'
        ]) &&
        isValidPrivateUserDoc(incoming());
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        isValidPrivateUserDoc(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'bio', 'photoURL', 'coverURL',
          'isPublic', 'showSavedNovels', 'showReadingHistory', 'showProfileInfo', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Owner-only bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) &&
          isValidId(bookmarkId) &&
          incoming().userId == userId &&
          incoming().novelId is string &&
          incoming().novelId.size() <= 100;
        allow update: if isValidId(userId) && isOwner(userId) &&
          isValidId(bookmarkId) &&
          incoming().userId == userId;
        allow delete: if isValidId(userId) && isOwner(userId) && isValidId(bookmarkId);
      }

      // Owner-only reading history subcollection
      match /history/{historyId} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId) &&
          isValidId(historyId) &&
          incoming().userId == userId &&
          incoming().novelId is string && incoming().novelId.size() <= 128 &&
          incoming().chapterId is number;
        allow delete: if isValidId(userId) && isOwner(userId) && isValidId(historyId);
      }

      // Owner-only ratings subcollection
      match /ratings/{ratingId} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId) &&
          isValidId(ratingId) &&
          incoming().userId == userId &&
          incoming().rating is number &&
          incoming().rating >= 1 &&
          incoming().rating <= 5;
        allow delete: if isValidId(userId) && isOwner(userId) && isValidId(ratingId);
      }
    }

    // ================= PRIVACY-GATED PUBLIC PROFILES ================= //
    match /public_profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || resource.data.isPublic == true);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        incoming().uid == userId &&
        incoming().keys().hasOnly([
          'uid', 'displayName', 'username', 'photoURL', 'coverURL',
          'isPublic', 'showSavedNovels', 'showReadingHistory', 'showProfileInfo',
          'createdAt', 'updatedAt'
        ]) &&
        isValidPublicProfile(incoming()) &&
        (!('username' in incoming()) || incoming().username == '' ||
         (isAllowedUsernameWrite(incoming().username) &&
          existsAfter(/databases/$(database)/documents/usernames/$(incoming().username)) &&
          getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == userId));
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        isValidPublicProfile(incoming()) &&
        (incoming().username == existing().username ||
         incoming().username == '' ||
         (isAllowedUsernameWrite(incoming().username) &&
          existsAfter(/databases/$(database)/documents/usernames/$(incoming().username)) &&
          getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == userId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'coverURL',
          'isPublic', 'showSavedNovels', 'showReadingHistory', 'showProfileInfo', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Bio & profile details subcollection (enforces showProfileInfo at DB rules level)
      match /details/{detailId} {
        allow get: if isValidId(userId) && detailId == 'bio' && (
          isOwner(userId) ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/public_profiles/$(userId)) &&
           get(/databases/$(database)/documents/public_profiles/$(userId)).data.isPublic == true &&
           get(/databases/$(database)/documents/public_profiles/$(userId)).data.showProfileInfo == true)
        );
        allow list: if false;
        allow create, update: if isValidId(userId) && detailId == 'bio' && isOwner(userId) &&
          incoming().keys().hasAll(['uid', 'bio', 'updatedAt']) &&
          incoming().keys().hasOnly(['uid', 'bio', 'updatedAt']) &&
          incoming().uid == userId &&
          incoming().bio is string && incoming().bio.size() <= 320 &&
          incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
        allow delete: if isValidId(userId) && detailId == 'bio' && isOwner(userId);
      }

      // Account summary statistics (saved novels count & chapters read count gated separately)
      match /stats/{statId} {
        allow get: if isValidId(userId) && (
          isOwner(userId) ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/public_profiles/$(userId)) &&
           get(/databases/$(database)/documents/public_profiles/$(userId)).data.isPublic == true &&
           ((statId == 'saved' && get(/databases/$(database)/documents/public_profiles/$(userId)).data.showSavedNovels == true) ||
            (statId == 'reading' && get(/databases/$(database)/documents/public_profiles/$(userId)).data.showReadingHistory == true)))
        );
        allow list: if false;
        allow create, update: if isValidId(userId) && statId in ['saved', 'reading'] && isOwner(userId) &&
          incoming().keys().hasAll(['uid', 'count', 'updatedAt']) &&
          incoming().keys().hasOnly(['uid', 'count', 'updatedAt']) &&
          incoming().uid == userId &&
          incoming().count is number &&
          incoming().count >= 0 &&
          incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
        allow delete: if isValidId(userId) && statId in ['saved', 'reading'] && isOwner(userId);
      }

      // Visitor-readable saved novels (strictly gated by isPublic && showSavedNovels)
      match /saved_novels/{novelId} {
        allow read: if isValidId(userId) && (
          isOwner(userId) ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/public_profiles/$(userId)) &&
           get(/databases/$(database)/documents/public_profiles/$(userId)).data.isPublic == true &&
           get(/databases/$(database)/documents/public_profiles/$(userId)).data.showSavedNovels == true)
        );
        allow create, update: if isValidId(userId) && isValidId(novelId) && isOwner(userId) &&
          incoming().keys().hasOnly(['userId', 'novelId', 'novelTitle', 'author', 'genre', 'coverUrl', 'createdAt']) &&
          incoming().userId == userId &&
          incoming().novelId == novelId &&
          (!('novelTitle' in incoming()) || (incoming().novelTitle is string && incoming().novelTitle.size() <= 160)) &&
          (!('author' in incoming()) || (incoming().author is string && incoming().author.size() <= 80)) &&
          (!('genre' in incoming()) || (incoming().genre is string && incoming().genre.size() <= 80)) &&
          (!('coverUrl' in incoming()) || isValidSafeImageUrl(incoming().coverUrl));
        allow delete: if isValidId(userId) && isValidId(novelId) && isOwner(userId);
      }
    }

    // ================= ATOMIC USERNAME RESERVATION & REDIRECTS ================= //
    match /usernames/{usernameLower} {
      allow get: if isAllowedUsernamePath(usernameLower);
      allow list: if false;
      allow create: if isSignedIn() &&
        isAllowedUsernameWrite(usernameLower) &&
        !exists(/databases/$(database)/documents/usernames/$(usernameLower)) &&
        incoming().keys().hasAll(['uid', 'username', 'isPublic', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'username', 'isPublic', 'updatedAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().username == usernameLower &&
        incoming().isPublic is bool &&
        getAfter(/databases/$(database)/documents/public_profiles/$(request.auth.uid)).data.username == usernameLower;
      allow update: if isSignedIn() &&
        isAllowedUsernameWrite(usernameLower) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().username == usernameLower &&
        incoming().isPublic is bool &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isPublic', 'updatedAt']);
      allow delete: if isSignedIn() &&
        isAllowedUsernamePath(usernameLower) &&
        existing().uid == request.auth.uid;
    }

    match /username_redirects/{oldUsername} {
      allow get: if isAllowedUsernamePath(oldUsername);
      allow list: if false;
      allow create: if isSignedIn() &&
        isAllowedUsernameWrite(oldUsername) &&
        !exists(/databases/$(database)/documents/username_redirects/$(oldUsername)) &&
        incoming().keys().hasAll(['uid', 'currentUsername', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'currentUsername', 'updatedAt']) &&
        incoming().uid == request.auth.uid &&
        isAllowedUsernameWrite(incoming().currentUsername) &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow update: if isSignedIn() &&
        isAllowedUsernamePath(oldUsername) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().keys().hasOnly(['uid', 'currentUsername', 'updatedAt']) &&
        isAllowedUsernameWrite(incoming().currentUsername) &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if isSignedIn() &&
        isAllowedUsernamePath(oldUsername) &&
        existing().uid == request.auth.uid;
    }

    // ================= PUBLISHED NOVELS & WRITER STUDIO TREE ================= //
    match /novels/{novelId} {
      allow read: if resource.data.isPublished == true ||
                    (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));

      allow create: if isValidId(novelId) &&
        isApprovedWriter() &&
        incoming().id == novelId &&
        incoming().authorId == request.auth.uid &&
        incoming().get('moderationStatus', 'active') == 'active' &&
        incoming().get('verifiedReadsCount', 0) == 0 &&
        incoming().get('reportCount', 0) == 0 &&
        isValidNovelPayload(incoming());

      allow update: if isValidId(novelId) && (
        // 1. Founder/Admin full moderation & cleanup update
        (isAdmin() &&
         incoming().id == existing().id &&
         incoming().authorId == existing().authorId &&
         isValidNovelPayload(incoming())) ||

        // 2. Novel author updating novel content/stats (cannot forge verifiedReadsCount or re-publish removed novels)
        (isApprovedWriter() &&
         existing().authorId == request.auth.uid &&
         incoming().id == existing().id &&
         incoming().authorId == existing().authorId &&
         incoming().get('verifiedReadsCount', 0) == existing().get('verifiedReadsCount', 0) &&
         incoming().get('reportCount', 0) == existing().get('reportCount', 0) &&
         incoming().get('moderationStatus', 'active') == existing().get('moderationStatus', 'active') &&
         (existing().get('moderationStatus', 'active') != 'rejected_removed' || incoming().isPublished == false) &&
         isValidNovelPayload(incoming())) ||

        // 3. Server-verified 60s Read increment (atomic batch paired with read_sessions + verified_reads)
        (incoming().diff(existing()).affectedKeys().hasOnly(['verifiedReadsCount', 'lastVerifiedReadKey']) &&
         incoming().verifiedReadsCount is int &&
         incoming().verifiedReadsCount == (existing().get('verifiedReadsCount', 0) + 1) &&
         incoming().lastVerifiedReadKey is string &&
         isValidId(incoming().lastVerifiedReadKey) &&
         !exists(/databases/$(database)/documents/novels/$(novelId)/verified_reads/$(incoming().lastVerifiedReadKey)) &&
         existsAfter(/databases/$(database)/documents/novels/$(novelId)/verified_reads/$(incoming().lastVerifiedReadKey))) ||

        // 4. Signed-in reader submitting a unique work_report (escalates to under_review at >= 3 reports)
        (isSignedIn() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['reportCount', 'moderationStatus', 'updatedAt']) &&
         !exists(/databases/$(database)/documents/work_reports/$(novelId + '__' + request.auth.uid)) &&
         existsAfter(/databases/$(database)/documents/work_reports/$(novelId + '__' + request.auth.uid)) &&
         incoming().reportCount is int &&
         incoming().reportCount == (existing().get('reportCount', 0) + 1) &&
         incoming().updatedAt is string && incoming().updatedAt.size() <= 64 &&
         ((incoming().reportCount >= 3 && incoming().moderationStatus == 'under_review') ||
          (incoming().reportCount < 3 && incoming().moderationStatus == existing().get('moderationStatus', 'active'))))
      );

      allow delete: if isValidId(novelId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      // ---- Novel Sections / Volumes ---- //
      match /sections/{sectionId} {
        allow read: if isValidId(novelId) && isValidId(sectionId) && (
          isNovelPubliclyVisible(novelId) || isNovelAuthor(novelId) || isAdmin()
        );
        allow create: if isValidId(novelId) && isValidId(sectionId) &&
          isApprovedWriter() &&
          isNovelAuthor(novelId) &&
          incoming().id == sectionId &&
          incoming().authorId == request.auth.uid &&
          isValidSectionPayload(incoming(), novelId);
        allow update: if isValidId(novelId) && isValidId(sectionId) && (
          isAdmin() ||
          (isApprovedWriter() &&
           isNovelAuthor(novelId) &&
           existing().authorId == request.auth.uid &&
           incoming().id == existing().id &&
           incoming().authorId == existing().authorId &&
           isValidSectionPayload(incoming(), novelId))
        );
        allow delete: if isValidId(novelId) && isValidId(sectionId) && (
          isNovelAuthor(novelId) || isAdmin()
        );
      }

      // ---- Atomic Chapter Slot Lock (Unique chapterNumber per novel) ---- //
      match /chapter_slots/{slotId} {
        allow read: if isValidId(novelId) && slotId.matches('^slot_[1-9][0-9]{0,5}$') && (
          isNovelAuthor(novelId) || isAdmin()
        );
        allow create: if isValidId(novelId) &&
          slotId.matches('^slot_[1-9][0-9]{0,5}$') &&
          isApprovedWriter() &&
          isNovelAuthor(novelId) &&
          incoming().keys().hasAll(['chapterId', 'chapterNumber', 'authorId', 'createdAt']) &&
          incoming().keys().hasOnly(['chapterId', 'chapterNumber', 'authorId', 'createdAt']) &&
          incoming().authorId == request.auth.uid &&
          incoming().chapterId is string && isValidId(incoming().chapterId) &&
          incoming().chapterNumber is int &&
          incoming().chapterNumber >= 1 &&
          slotId == ('slot_' + string(incoming().chapterNumber)) &&
          incoming().createdAt is string && incoming().createdAt.size() <= 64 &&
          !exists(/databases/$(database)/documents/novels/$(novelId)/chapter_slots/$(slotId)) &&
          existsAfter(/databases/$(database)/documents/novels/$(novelId)/chapters/$(incoming().chapterId));
        allow update: if false;
        allow delete: if isValidId(novelId) &&
          slotId.matches('^slot_[1-9][0-9]{0,5}$') &&
          (isNovelAuthor(novelId) || isAdmin());
      }

      // ---- Logical Bilingual Chapters ---- //
      match /chapters/{chapterId} {
        allow read: if isValidId(novelId) && isValidId(chapterId) && (
          (resource.data.isPublished == true && isNovelPubliclyVisible(novelId)) ||
          isNovelAuthor(novelId) ||
          isAdmin()
        );
        allow create: if isValidId(novelId) && isValidId(chapterId) &&
          isApprovedWriter() &&
          isNovelAuthor(novelId) &&
          incoming().id == chapterId &&
          incoming().authorId == request.auth.uid &&
          incoming().revision == 1 &&
          isValidChapterPayload(incoming(), novelId) &&
          !exists(/databases/$(database)/documents/novels/$(novelId)/chapter_slots/$('slot_' + string(incoming().chapterNumber))) &&
          existsAfter(/databases/$(database)/documents/novels/$(novelId)/chapter_slots/$('slot_' + string(incoming().chapterNumber)));
        allow update: if isValidId(novelId) && isValidId(chapterId) && (
          isAdmin() ||
          (isApprovedWriter() &&
           isNovelAuthor(novelId) &&
           existing().authorId == request.auth.uid &&
           incoming().id == existing().id &&
           incoming().authorId == existing().authorId &&
           incoming().chapterNumber == existing().chapterNumber &&
           incoming().revision == existing().revision + 1 &&
           isValidChapterPayload(incoming(), novelId))
        );
        allow delete: if isValidId(novelId) && isValidId(chapterId) && (
          isNovelAuthor(novelId) || isAdmin()
        );
      }

      // ---- Server-Timed 60-Second Read Sessions & Verified Reads ---- //
      match /read_sessions/{sessionId} {
        allow get: if isValidId(novelId) && isValidId(sessionId);
        allow list: if isNovelAuthor(novelId) || isAdmin();
        allow create: if isValidId(novelId) && isValidId(sessionId) &&
          isNovelPubliclyVisible(novelId) &&
          incoming().keys().hasAll(['sessionId', 'novelId', 'chapterId', 'readerKey', 'startedAt', 'consumed']) &&
          incoming().keys().hasOnly(['sessionId', 'novelId', 'chapterId', 'readerKey', 'userId', 'startedAt', 'consumed']) &&
          incoming().sessionId == sessionId &&
          incoming().novelId == novelId &&
          incoming().chapterId is string && isValidId(incoming().chapterId) &&
          incoming().readerKey is string && isValidId(incoming().readerKey) &&
          (!('userId' in incoming()) || !isSignedIn() || incoming().userId == request.auth.uid) &&
          incoming().startedAt == request.time &&
          incoming().consumed == false;
        allow update: if isValidId(novelId) && isValidId(sessionId) &&
          existing().consumed == false &&
          incoming().consumed == true &&
          incoming().diff(existing()).affectedKeys().hasOnly(['consumed']) &&
          request.time >= existing().startedAt + duration.value(60, 's') &&
          existsAfter(/databases/$(database)/documents/novels/$(novelId)/verified_reads/$(existing().readerKey));
        allow delete: if isNovelAuthor(novelId) || isAdmin();
      }

      match /verified_reads/{readerKey} {
        allow get: if isValidId(novelId) && isValidId(readerKey);
        allow list: if isNovelAuthor(novelId) || isAdmin();
        allow create: if isValidId(novelId) && isValidId(readerKey) &&
          isNovelPubliclyVisible(novelId) &&
          !exists(/databases/$(database)/documents/novels/$(novelId)/verified_reads/$(readerKey)) &&
          incoming().keys().hasAll(['novelId', 'readerKey', 'chapterId', 'sessionId', 'verifiedAt']) &&
          incoming().keys().hasOnly(['novelId', 'readerKey', 'userId', 'chapterId', 'sessionId', 'verifiedAt']) &&
          incoming().novelId == novelId &&
          incoming().readerKey == readerKey &&
          incoming().sessionId is string && isValidId(incoming().sessionId) &&
          incoming().chapterId is string && isValidId(incoming().chapterId) &&
          incoming().verifiedAt == request.time &&
          exists(/databases/$(database)/documents/novels/$(novelId)/read_sessions/$(incoming().sessionId)) &&
          get(/databases/$(database)/documents/novels/$(novelId)/read_sessions/$(incoming().sessionId)).data.readerKey == readerKey &&
          get(/databases/$(database)/documents/novels/$(novelId)/read_sessions/$(incoming().sessionId)).data.consumed == false &&
          getAfter(/databases/$(database)/documents/novels/$(novelId)/read_sessions/$(incoming().sessionId)).data.consumed == true &&
          request.time >= get(/databases/$(database)/documents/novels/$(novelId)/read_sessions/$(incoming().sessionId)).data.startedAt + duration.value(60, 's');
        allow update: if false;
        allow delete: if isNovelAuthor(novelId) || isAdmin();
      }
    }

    // ================= WORK REPORTS & MODERATION TRIAGE ================= //
    match /work_reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (
        resource.data.reporterUid == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().keys().hasAll(['id', 'novelId', 'novelTitle', 'authorId', 'reporterUid', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['id', 'novelId', 'novelTitle', 'authorId', 'reporterUid', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
        incoming().id == reportId &&
        incoming().novelId is string && isValidId(incoming().novelId) &&
        incoming().novelTitle is string && incoming().novelTitle.size() <= 140 &&
        incoming().authorId is string && incoming().authorId.size() <= 128 &&
        incoming().reporterUid == request.auth.uid &&
        reportId == (incoming().novelId + '__' + request.auth.uid) &&
        !exists(/databases/$(database)/documents/work_reports/$(reportId)) &&
        incoming().reason is string && incoming().reason.size() >= 2 && incoming().reason.size() <= 120 &&
        (!('details' in incoming()) || (incoming().details is string && incoming().details.size() <= 1000)) &&
        incoming().status == 'open' &&
        incoming().createdAt is string && incoming().createdAt.size() <= 64 &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow update: if isValidId(reportId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().novelId == existing().novelId &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().status in ['open', 'reviewed_kept', 'rejected_removed'];
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // ================= PUBLIC CHAPTER COMMENTS & MODERATION ================= //
    match /comments/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if resource.data.text is string;
      allow create: if isSignedIn() && isValidId(commentId) &&
        incoming().userId == request.auth.uid &&
        incoming().text is string && incoming().text.size() <= 1500 &&
        incoming().likes == 0;
      allow update: if isSignedIn() && isValidId(commentId) && (
        (existing().userId == request.auth.uid &&
         incoming().userId == existing().userId &&
         incoming().likes == existing().likes &&
         incoming().text is string && incoming().text.size() <= 1500) ||
        (incoming().userId == existing().userId &&
         incoming().text == existing().text &&
         (incoming().likes == existing().likes + 1 ||
          (incoming().likes == existing().likes - 1 && incoming().likes >= 0)))
      );
      allow delete: if isSignedIn() && isValidId(commentId) &&
        (existing().userId == request.auth.uid || isAdmin());

      match /reactions/{reactionUserId} {
        allow get: if isValidId(commentId) && isValidId(reactionUserId);
        allow list: if isValidId(commentId) && resource.data.userId is string;
        allow create: if isSignedIn() &&
          isValidId(reactionUserId) &&
          reactionUserId == request.auth.uid &&
          incoming().userId == request.auth.uid &&
          incoming().commentId == commentId &&
          incoming().type is string && incoming().type.size() <= 20;
        allow delete: if isSignedIn() &&
          isValidId(reactionUserId) &&
          (reactionUserId == request.auth.uid || isAdmin());
      }
    }

    match /audit_reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.novelId is string;
      allow create: if isAuditor() && isValidId(reviewId) &&
        incoming().reviewerId == request.auth.uid &&
        incoming().decision in ['approved', 'issues_found'] &&
        incoming().novelId is string && incoming().novelId.size() <= 128;
      allow update, delete: if isAdmin();
    }

    match /work_moderation/{novelId} {
      allow get: if isValidId(novelId);
      allow list: if resource.data.status is string;
      allow write: if isAdmin() || isAuditor();
    }

    match /moderation_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isAuditor());
      allow create: if isAdmin() && isValidId(logId) && incoming().decidedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
